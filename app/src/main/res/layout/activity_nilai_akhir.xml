<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_margin="10dp"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".intent.NilaiAkhirActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nilai Akhir"
        android:layout_gravity="center"
        android:textSize="24sp"
        android:textStyle="bold"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NIM"
        android:id="@+id/tvNim"
        android:layout_marginTop="30dp"
        android:layout_marginStart="10dp"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nama"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvNama"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Program Studi"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvProdi"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jenis Kelamin"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvJK"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Kehadiran"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvKehadiran"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tugas"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvTgs"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UTS"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvUts"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="UAS"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:id="@+id/tvUas"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nilai Akhir"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:id="@+id/tvNilaiAkhir"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nilai Huruf"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:textStyle="bold"
        android:textSize="20dp"
        android:id="@+id/tvNilaiHuruf"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Waktu Input"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:textStyle="italic"
        android:id="@+id/tvWaktuInput"
        />

</LinearLayout>