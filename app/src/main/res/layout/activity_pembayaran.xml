<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.widget.PembayaranActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu Makanan"
            android:textSize="24sp"
            android:layout_gravity="center"
            android:textStyle="bold"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="List Makanan"
            android:layout_marginTop="10dp"
            />

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            >
        <TableRow>
            <CheckBox
                android:text="Nasi Goreng @Rp.12.000"
                android:id="@+id/cbNasgor"
                />
            <EditText
                android:hint="1"
                android:layout_marginStart="10dp"
                android:id="@+id/etNasgor"
                android:inputType="number"
                />
        </TableRow>

            <TableRow>
                <CheckBox
                    android:text="Mie Goreng @Rp.10.000"
                    android:id="@+id/cbMiegor"
                    />
                <EditText
                    android:hint="1"
                    android:layout_marginStart="10dp"
                    android:id="@+id/etMiegor"
                    android:inputType="number"
                    />
            </TableRow>

            <TableRow>
                <CheckBox
                    android:text="Soto @Rp.12.000"
                    android:id="@+id/cbSoto"
                    />
                <EditText
                    android:hint="1"
                    android:layout_marginStart="10dp"
                    android:id="@+id/etSoto"
                    android:inputType="number"
                    />
            </TableRow>

            <TableRow>
                <CheckBox
                    android:text="Lontong @Rp.8.000"
                    android:id="@+id/cbLontong"
                    />
                <EditText
                    android:hint="1"
                    android:layout_marginStart="10dp"
                    android:id="@+id/etLontong"
                    android:inputType="number"
                    />
            </TableRow>

            <TableRow>
                <CheckBox
                    android:text="Ayam Geprek @Rp.15.000"
                    android:id="@+id/cbAygep"
                    />
                <EditText
                    android:hint="1"
                    android:layout_marginStart="10dp"
                    android:id="@+id/etAygep"
                    android:inputType="number"
                    />
            </TableRow>

        </TableLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jenis Pelanggan"
            android:layout_marginTop="10dp"
            />

        <Spinner
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:id="@+id/spnJnsPelanggan"
            android:layout_marginTop="4dp"
            />

        <Button
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="25dp"
            android:text="Bayar"
            android:id="@+id/btnBayar"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/tvTotal"
            />

    </LinearLayout>

</ScrollView>